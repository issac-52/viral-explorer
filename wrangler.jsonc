{
  "name": "exitviral",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  // AI context analysis turns on when the AI_API_KEY secret is set.
  // Any OpenAI-compatible chat completions endpoint works.
  "vars": { "AI_MODEL": "gpt-4o-mini", "AI_BASE_URL": "https://api.openai.com/v1" },
  "assets": { "directory": "./dist", "run_worker_first": ["/api/*"] },
  "ratelimits": [{
    "name": "ANALYSIS_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 20, "period": 60 }
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "exitviral",
    "database_id": "00000000-0000-0000-0000-000000000001"
  }]
}
